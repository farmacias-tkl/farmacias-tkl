# =============================================================================
# Farmacias TKL — Variables de entorno
# Copiar este archivo a .env.local para desarrollo local
# NO commitear .env ni .env.local con valores reales
# =============================================================================

# ---------------------------------------------------------------------------
# BASE DE DATOS
# ---------------------------------------------------------------------------
# Desarrollo local: PostgreSQL local
# DATABASE_URL="<CONNECTION_STRING_LOCAL>"
#   (esquema postgresql, usuario y password locales, host localhost:5432, base tkl_dev)
#
# Producción/demo (Neon — recomendado para Vercel):
# DATABASE_URL="<CONNECTION_STRING_DE_NEON>"
#   (copiarla del dashboard de Neon; esquema postgresql, terminada en ?sslmode=require)
#
# Alternativa (Supabase):
# DATABASE_URL="<CONNECTION_STRING_DE_SUPABASE>"
#   (esquema postgresql, host db.<proyecto>.supabase.co:5432, base postgres)
DATABASE_URL=""

# ---------------------------------------------------------------------------
# NEXTAUTH / AUTENTICACIÓN
# ---------------------------------------------------------------------------
# Secret para firmar JWT. Generar con: openssl rand -base64 32
# En Vercel se puede generar automáticamente desde el panel
NEXTAUTH_SECRET=""

# URL base de la aplicación
# Desarrollo: http://localhost:3000
# Producción: https://tu-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# ENTORNO
# ---------------------------------------------------------------------------
# "development" | "production" | "test"
# En desarrollo el seed usa contraseña genérica TKL.Dev.2025!
# En producción genera contraseñas únicas por usuario
NODE_ENV="development"

# ---------------------------------------------------------------------------
# DASHBOARD EJECUTIVO
# ---------------------------------------------------------------------------
# Service Account de Google (JSON completo en una sola línea) para leer Drive
GOOGLE_SERVICE_ACCOUNT_JSON=""

# ID de la carpeta de Drive donde se sube el Excel de saldos bancarios
GOOGLE_DRIVE_FOLDER_ID=""

# ID de la carpeta de Drive donde el script Python del servidor SIAF sube los CSV de ventas diarias
GOOGLE_DRIVE_SIAF_CSV_FOLDER_ID=""

# Secret para validar el webhook /api/sync/trigger (usar openssl rand -base64 32)
SYNC_WEBHOOK_SECRET=""

# URL del dashboard ejecutivo (visible server-side)
EXECUTIVE_DASHBOARD_URL="http://dashboard.localhost:3000"

# URL del dashboard ejecutivo (visible en el cliente, usada por el TopBar operativo)
NEXT_PUBLIC_EXECUTIVE_DASHBOARD_URL="http://dashboard.localhost:3000"
